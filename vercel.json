{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "express",
  "functions": {
    "src/index.js": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/cron/expire-pending",
      "schedule": "* * * * *"
    }
  ],
  "rewrites": [
    { "source": "/", "destination": "/index.html" }
  ]
}
