# =============================================================================
# VIDIA V2 — Environment Variables
# Copy this file to `.env` and fill in your values.
# NEVER commit `.env` to version control.
# =============================================================================

# --- Server ---
PORT=3000
NODE_ENV=development

# --- Supabase (Project Settings → API) ---
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# --- Meta WhatsApp Cloud API (legacy / optional handshake) ---
# META_WEBHOOK_VERIFY_TOKEN=your-meta-webhook-verify-token

# --- Twilio WhatsApp ---
# Set credentials per business in Supabase Admin (no .env fallback for sends).

# --- Admin Dashboard ---
ADMIN_PASSWORD=your-secure-admin-password

# --- Google Calendar ---
# Service Account credentials are stored in Supabase system_settings and edited in
# Admin → Setări sistem (google_service_account_email + google_service_account_private_key).
# Per business: google_calendar_id = shared calendar email + optional mock mode.
# Share each client calendar with the Service Account email (Make changes to events).
#
# Optional infrastructure (also used for client “Add to calendar” .ics links):
# PUBLIC_WEBHOOK_BASE_URL=https://api.vidia.ro

# --- Optional: AI (Dialogue Agent) ---
# Gemini is primary for conversational parse; OpenAI is fallback.
# GEMINI_API_KEY=AIza...
# GEMINI_MODEL=gemini-3.5-flash-lite
# (Do NOT use gemini-2.0-flash — retired Jun 2026, returns HTTP 404.)
# OPENAI_API_KEY=sk-...

# --- Optional: WhatsApp mock mode ---
# WHATSAPP_MOCK_MODE=true

# =============================================================================
# Vercel (Project → Settings → Environment Variables)
# Do NOT upload this file. Add the keys below in the Vercel dashboard.
# Production: NODE_ENV=production
# =============================================================================
# Required:
#   SUPABASE_URL
#   SUPABASE_SERVICE_ROLE_KEY
#   ADMIN_PASSWORD
#   NODE_ENV=production
# Recommended:
#   GEMINI_API_KEY
#   OPENAI_API_KEY
#   PUBLIC_WEBHOOK_BASE_URL=https://your-app.vercel.app
#   CRON_SECRET=long-random-string
#     (Vercel Cron sends Authorization: Bearer <CRON_SECRET> to /cron/expire-pending)
# Optional:
#   CORS_ORIGINS=https://your-app.vercel.app
#   META_WEBHOOK_VERIFY_TOKEN
# Not needed on Vercel:
#   PORT (set by the platform)
#   TWILIO_* (per business in Admin / Supabase)
# After deploy, set Twilio webhook to:
#   https://your-app.vercel.app/webhook/whatsapp
# Cron (every minute): /cron/expire-pending — releases pending holds past Admin TTL
